{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "rimraf node_modules/.prisma && npx prisma generate && npx prisma migrate deploy",
    "postinstall": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:generate": "npx prisma generate",
    "migrate": "cross-env NODE_ENV=development npx prisma migrate dev",
    "migrate:prod": "cross-env NODE_ENV=production npx prisma migrate deploy",
    "test:unit": "jest --passWithNoTests",
    "test:integration": "NODE_ENV=test npm run migrate:prod && jest --config jest.config.integration.js",
    "test:smoke": "node test/smoke-tests.js",
    "test:e2e": "NODE_ENV=test npm run migrate:prod && jest --config jest.config.e2e.js",
    "test:load": "autocannon http://localhost:5000 -c 10 -d 30",
    "lint": "eslint src --fix",
    "db:health": "node scripts/db-health.js",
    "db:verify": "node scripts/db-verify.js",
    "db:analyze-queries": "node scripts/analyze-queries.js",
    "db:optimize": "node scripts/optimize-db.js",
    "deploy:check": "node deployment-check.js",
    "monitor:prod": "node production-monitor.js",
    "backup:create": "node backup-recovery.js create",
    "backup:list": "node backup-recovery.js list",
    "backup:restore": "node backup-recovery.js restore",
    "backup:cleanup": "node backup-recovery.js cleanup",
    "backup:verify": "node backup-recovery.js verify",
    "reset:db": "node reset-database.js",
    "setup:nafdac-admin": "node setup-nafdac-admin.js",
    "gc:force": "node --expose-gc -e 'require(\"gc\").collect()'",
    "seed:prod": "cross-env NODE_ENV=production npx prisma db seed"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@google/generative-ai": "^0.24.1",
    "@huggingface/inference": "^4.13.5",
    "@prisma/client": "^6.0.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "geojson": "^0.5.0",
    "google-auth-library": "^10.6.1",
    "googleapis": "^171.4.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.11",
    "openai": "^6.15.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.31.1",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.11",
    "prisma": "^6.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
